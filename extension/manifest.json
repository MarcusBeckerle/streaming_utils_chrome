{
  "manifest_version": 3,
  "name": "Streaming Utils",
  "version": "1.2.2",
  "description": "Werbung auf YouTube und Amazon Prime Video beschleunigen und überspringen. YouTube als Video oder MP3 speichern.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging",
    "downloads",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Streaming Utils",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "ad-controller.js",
        "ad-skipper.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": [
        "ad-controller.js",
        "amazon-ads.js",
        "amazon-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
